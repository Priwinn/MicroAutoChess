{
  "version": "0.2.0",
  "configurations": [
    {"name":"Python Debugger: Current File","type":"debugpy","request":"launch","program":"${file}","console":"integratedTerminal"},
    {
      "name": ".NET Launch (MicroAutoChess.App)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/csharp/MicroAutoChess.App/bin/Debug/net10.0-windows/MicroAutoChess.App.exe",
      "args": ["--gui"],
      "cwd": "${workspaceFolder}/csharp/MicroAutoChess.App",
      "console": "integratedTerminal",
      "stopAtEntry": false
    },
    {
      "name": ".NET Launch (MicroAutoChess.AvaloniaApp)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build: avalonia",
      "program": "${workspaceFolder}/csharp/MicroAutoChess.AvaloniaApp/bin/Debug/net10.0/MicroAutoChess.AvaloniaApp.dll",
      "args": [],
      "cwd": "${workspaceFolder}/csharp/MicroAutoChess.AvaloniaApp",
      "console": "integratedTerminal",
      "stopAtEntry": false
    },
    {
      "name": "Python: Visualize Combat",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/src/core/visualize_combat.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": false,
      "python": "${workspaceFolder}/venv/Scripts/python.exe"
    }
    ,
    {
      "name": "Attach to Process (.NET)",
      "type": "coreclr",
      "request": "attach",
      "processId": "${command:pickProcess}",
      "justMyCode": false
    }
  ]
}
